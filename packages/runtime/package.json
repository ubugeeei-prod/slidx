{
  "name": "@slidxjs/runtime",
  "version": "0.6.0",
  "description": "Client runtime for slidx decks: step resolution, navigation, and mirroring",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ubugeeei-prod/slidx.git",
    "directory": "packages/runtime"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./emitted": {
      "types": "./dist/emitted/emitted.d.mts",
      "default": "./dist/emitted/emitted.mjs"
    },
    "./presenter": {
      "types": "./dist/presenter/presenter.d.mts",
      "default": "./dist/presenter/presenter.mjs"
    },
    "./camera": {
      "types": "./dist/camera/camera.d.mts",
      "default": "./dist/camera/camera.mjs"
    },
    "./effects.css": "./dist/effects.css"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "pack:lib": "vp pack src/index.ts --dts --out-dir dist && vp pack src/emitted.ts --dts --out-dir dist/emitted && vp pack src/presenter.ts --dts --out-dir dist/presenter && vp pack src/camera.ts --dts --out-dir dist/camera && node ../../scripts/copy-assets.mjs src/effects.css dist/effects.css"
  },
  "devDependencies": {
    "@slidxjs/wasm": "workspace:*"
  }
}
