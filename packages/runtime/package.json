{
  "name": "@ubugeeei/slidx-runtime",
  "version": "0.1.0",
  "description": "Client runtime for slidx decks: step resolution, navigation, and mirroring",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ubugeeei-prod/slidx.git",
    "directory": "packages/runtime"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./effects.css": "./dist/effects.css"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "pack:lib": "vp pack src/index.ts --dts --out-dir dist && node ../../scripts/copy-assets.mjs src/effects.css dist/effects.css"
  },
  "devDependencies": {
    "@ubugeeei/slidx-wasm": "workspace:*"
  }
}
