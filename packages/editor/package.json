{
  "name": "@slidx/editor",
  "version": "0.1.0",
  "description": "The slidx visual editor: deck outline, slide canvas, and inspector, writing back to Markdown",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ubugeeei-prod/slidx.git",
    "directory": "packages/editor"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "pack:lib": "vp pack src/index.ts --dts --out-dir dist"
  },
  "dependencies": {
    "@slidx/runtime": "workspace:*"
  },
  "devDependencies": {
    "@slidx/runtime": "workspace:*"
  }
}
