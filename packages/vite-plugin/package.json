{
  "name": "@slidx/vite-plugin",
  "version": "0.0.1",
  "description": "Author, preview, and build slidx decks with Vite",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ubugeeei-prod/slidx.git",
    "directory": "packages/vite-plugin"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "pack:lib": "vp pack src/index.ts --dts --out-dir dist"
  },
  "dependencies": {
    "@slidx/runtime": "workspace:*",
    "@slidx/wasm": "workspace:*"
  },
  "peerDependencies": {
    "playwright": ">=1.40",
    "vite": ">=5"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    }
  }
}
